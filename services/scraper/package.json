{
  "name": "scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "start:zillow:all-cities": "tsx src/index.ts --source zillow --all-cities",
    "start:craigslist:all-cities": "tsx src/index.ts --source craigslist --all-cities",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "mongodb": "^7.1.0",
    "puppeteer": "^24.39.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
